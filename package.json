{
  "name": "appsmedjan",
  "private": true,
  "type": "module",
  "workspaces": ["server", "worker", "web"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "dev:mock-worker": "npm run start -w worker -- --mock",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "worker": "npm run start -w worker",
    "typecheck": "npm run typecheck --workspaces",
    "test": "tsx scripts/unit.ts",
    "test:e2e": "node scripts/e2e.mjs"
  }
}
