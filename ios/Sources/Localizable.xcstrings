            "state": "translated",
            "value": "A name"
          }
        }
      }
    },
    "Ett steg görs för hand hos Apple: skapa appen i App Store Connect (Apps > + > New App, iOS) och välj bundle-id %@. Uppladdningen fortsätter av sig själv när appen finns.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One step is done by hand at Apple: create the app in App Store Connect (Apps > + > New App, iOS) and pick the bundle ID %@. The upload goes on by itself once the app exists."
          }
        }
      }
    },
    "Fel e-post eller lösenord.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrong email or password."
