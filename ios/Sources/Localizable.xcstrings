{
  "sourceLanguage": "sv",
  "strings": {
    "": {},
    "%lld appar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld apps"
          }
        }
      }
    },
    "%lld av %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld"
          }
        }
      }
    },
    "%lld av dem går ut %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld of them run out on %@."
          }
        }
      }
    },
    "%lld credits": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld credits"
          }
        }
      }
    },
    "%lld credits att börja med": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld credits to start with"
          }
        }
      }
    },
    "%lld credits i månaden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld credits a month"
          }
        }
      }
    },
    "%lld delar skrivna": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld parts written"
          }
        }
      }
    },
    "%lld filer · %lld rader": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld files · %lld lines"
          }
        }
      }
    },
    "%lld maskiner arbetar med din app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld machines are working on your app"
          }
        }
      }
    },
    "%lld meddelanden till byggaren i månaden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld messages to the builder a month"
          }
        }
      }
    },
    "%lld/%lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld"
          }
        }
      }
    },
    "+ Lägg till": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "+ Add"
          }
        }
      }
    },
    "1 app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 app"
          }
        }
      }
    },
    "1 credit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 credit"
          }
        }
      }
    },
    "1 del skriven": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 part written"
          }
        }
      }
    },
    "1. Skaffa ett utvecklarkonto": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Get a developer account"
          }
        }
      }
    },
    "2. Skapa en nyckel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Create a key"
          }
        }
      }
    },
    "3. Koppla nyckeln": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Connect the key"
          }
        }
      }
    },
    "Alla appar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All apps"
          }
        }
      }
    },
    "Alla knappar trycks på, en efter en": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every button is pressed, one after another"
          }
        }
      }
    },
    "Alla maskiner är klara": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All the machines are done"
          }
        }
      }
    },
    "Allt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything"
          }
        }
      }
    },
    "Allt försvinner: dina appar, chattarna, telefonerna du har lagt till, din plan och dina credits. Det går inte att ångra.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything goes: your apps, the chats, the phones you have added, your plan and your credits. It cannot be undone."
          }
        }
      }
    },
    "Allt är inte ifyllt än.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not everything is filled in yet."
          }
        }
      }
    },
    "Ange en giltig e-postadress och ett lösenord på minst 8 tecken.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid email address and a password of at least 8 characters."
          }
        }
      }
    },
    "Anna  12": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna  12"
          }
        }
      }
    },
    "App Dance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Dance"
          }
        }
      }
    },
    "App Dance visar dem": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Dance shows them"
          }
        }
      }
    },
    "App Store": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store"
          }
        }
      }
    },
    "App Store-guiden ingår i planen Publicera. Du ber om den under Min plan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store guide is part of the plan Publish. You ask for it under My plan."
          }
        }
      }
    },
    "App Store-texter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store texts"
          }
        }
      }
    },
    "Appar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps"
          }
        }
      }
    },
    "Appar att skapa i App Store Connect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps to create in App Store Connect"
          }
        }
      }
    },
    "Appen byggs om i chatten. En ny version för telefonen görs klar av sig själv när det är färdigt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is being rebuilt in the chat. A new version for the phone is made ready by itself when that is done."
          }
        }
      }
    },
    "Appen finns i TestFlight om några minuter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is in TestFlight in a few minutes"
          }
        }
      }
    },
    "Appen finns inte hos Apple än. Skapa en ny app i App Store Connect, välj %@ i listan Bundle ID och försök igen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app does not exist at Apple yet. Create a new app in App Store Connect, pick %@ in the Bundle ID list, and try again."
          }
        }
      }
    },
    "Appen finns inte i App Store Connect än. Gör den installerbar först; då får du hjälp att skapa den.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app does not exist in App Store Connect yet. Make it installable first; that walks you through creating it."
          }
        }
      }
    },
    "Appen får ett minne, så att inget försvinner": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app gets a memory, so nothing is lost"
          }
        }
      }
    },
    "Appen gick inte att bygga. Be om en rättning i chatten och försök igen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app could not be built. Ask for a fix in the chat and try again."
          }
        }
      }
    },
    "Appen gick inte att göra i ordning för din telefon. Felet ligger hos oss, och vi har fått veta det.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app could not be made ready for your phone. The fault is ours, and we have been told."
          }
        }
      }
    },
    "Appen går inte att bygga just nu. Be om en rättning i chatten och försök igen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app cannot be built right now. Ask for a fix in the chat and try again."
          }
        }
      }
    },
    "Appen görs klar för din telefon.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is being made ready for your phone."
          }
        }
      }
    },
    "Appen har ingen version som väntar på att skickas in. Den kan redan vara inskickad.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app has no version waiting to be submitted. It may already have been submitted."
          }
        }
      }
    },
    "Appen hittades inte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app was not found."
          }
        }
      }
    },
    "Appen innehåller inget av det Apple frågar om för åldersgränsen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app has none of the content Apple asks about for the age rating"
          }
        }
      }
    },
    "Appen laddas upp till ditt konto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is being uploaded to your account."
          }
        }
      }
    },
    "Appen ligger på din hemskärm.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is on your home screen."
          }
        }
      }
    },
    "Appen lämnas till Apples granskning.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is being handed to Apple's review."
          }
        }
      }
    },
    "Appen på din egen telefon": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app on your own phone"
          }
        }
      }
    },
    "Appen på telefonen ingår i planen Skapa. Du ber om den under Min plan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app on your phone is part of the plan Create. You ask for it under My plan."
          }
        }
      }
    },
    "Appen ska vara gratis och finnas i alla länder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app should be free and available in every country"
          }
        }
      }
    },
    "Appen skickas nu in till Apple för granskning, i ditt namn.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is now submitted to Apple for review, in your name."
          }
        }
      }
    },
    "Appen startas på en provtelefon": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is started on a test phone"
          }
        }
      }
    },
    "Appen visar inget material från andra som jag saknar rätt att använda": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app shows no material from others that I lack the rights to use"
          }
        }
      }
    },
    "Appen är för stor för att skriva ett förslag i ett steg.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is too large to write a suggestion in one step."
          }
        }
      }
    },
    "Appen är inskickad för granskning. Apple hör av sig till kontaktpersonen, oftast inom ett par dagar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app has been submitted for review. Apple gets in touch with the contact person, usually within a couple of days."
          }
        }
      }
    },
    "Appen är inskickad till Apple.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app has been handed in to Apple."
          }
        }
      }
    },
    "Appen är inte uppladdad än.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app has not been uploaded yet."
          }
        }
      }
    },
    "Appen är inte uppladdad än. Gör den installerbar först och skicka sidan igen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is not uploaded yet. Make it installable first and send the page again."
          }
        }
      }
    },
    "Appen är inte uppladdad än. Gör den installerbar först.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is not uploaded yet. Make it installable first."
          }
        }
      }
    },
    "Appen är skriven i Swift med SwiftUI. Byggaren skriver om filerna när du ber om ändringar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is written in Swift with SwiftUI. The builder rewrites the files when you ask for changes."
          }
        }
      }
    },
    "Appen är uppladdad. Du är tillagd som testare, så appen dyker upp i TestFlight-appen när Apple är klar, oftast efter några minuter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is uploaded. You have been added as a tester, so the app shows up in the TestFlight app once Apple is done, usually after a few minutes."
          }
        }
      }
    },
    "Appen är uppladdad. Lägg till dig som testare under TestFlight i App Store Connect, så dyker den upp i TestFlight-appen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is uploaded. Add yourself as a tester under TestFlight in App Store Connect, and it shows up in the TestFlight app."
          }
        }
      }
    },
    "Appen öppnas hos dig så fort den är klar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app opens for you the moment it is done."
          }
        }
      }
    },
    "Appens skärm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app's screen"
          }
        }
      }
    },
    "Appens version granskas eller är redan släppt, så sidan kan inte ändras härifrån.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app's version is in review or already released, so the page cannot be changed from here."
          }
        }
      }
    },
    "Appikon": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App icon"
          }
        }
      }
    },
    "Apple godkände inte allt på sidan. Något behöver rättas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple did not accept everything on the page. Something needs to be put right."
          }
        }
      }
    },
    "Apple godkände inte appen för test. Vi har fått veta varför och hör av oss.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple did not approve the app for testing. We have been told why and will get in touch."
          }
        }
      }
    },
    "Apple godkände inte din nyckel. Öppna Apple-konto i menyn bland dina appar och koppla kontot igen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple did not accept your key. Open Apple account in the menu by your apps and connect the account again."
          }
        }
      }
    },
    "Apple godkände inte nyckeln. Öppna Apple-konto i menyn bland dina appar och koppla kontot igen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple did not accept the key. Open Apple account in the menu by your apps and connect the account again."
          }
        }
      }
    },
    "Apple godkänner dig, oftast inom ett par dagar, och mejlar när det är klart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple approves you, usually within a couple of days, and mails you when it is done."
          }
        }
      }
    },
    "Apple granskar appen, oftast inom ett par dagar, och säger till när den är godkänd.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple reviews the app, usually within a couple of days, and tells you when it is approved."
          }
        }
      }
    },
    "Apple går igenom appen innan länken får användas. Första gången kan det ta upp till ett par dagar; nya versioner går fortare.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple looks the app over before the link may be used. The first time that can take up to a couple of days; new versions go faster."
          }
        }
      }
    },
    "Apple har skickat en inbjudan till %@. Öppna mejlet och tacka ja. Sedan kommer appen till TestFlight inom några minuter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple has sent an invitation to %@. Open the email and accept. The app then reaches TestFlight within a few minutes."
          }
        }
      }
    },
    "Apple har tagit emot telefonen men släpper inte in den i appar än. Det kan ta upp till tre dygn i ett nytt konto. Försök igen senare.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple has taken the phone in but does not let it into apps yet. That can take up to three days in a new account. Try again later."
          }
        }
      }
    },
    "Apple hör av sig till den här personen om något är oklart. Uppgifterna används för alla dina appar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple gets in touch with this person if something is unclear. The details are used for all your apps."
          }
        }
      }
    },
    "Apple kräver att varje app har en supportsida och en integritetspolicy på webben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple requires every app to have a support page and a privacy policy on the web."
          }
        }
      }
    },
    "Apple kräver båda. E-postadressen visas öppet på sidorna, tillsammans med ditt namn om du har fyllt i kontaktuppgifterna. Du ansvarar för att policyn stämmer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple requires both. The email address is shown openly on the pages, together with your name if you have filled in the contact details. You answer for the policy being true."
          }
        }
      }
    },
    "Apple kände inte igen nyckeln. Kontrollera att koden och filen kommer från samma sida hos Apple.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple did not recognise the key. Check that the code and the file come from the same page at Apple."
          }
        }
      }
    },
    "Apple packar upp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple is unpacking"
          }
        }
      }
    },
    "Apple provstartar appen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple is trying the app"
          }
        }
      }
    },
    "Apple räknar skruvarna": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple is counting the screws"
          }
        }
      }
    },
    "Apple sa nej till något här.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple said no to something here."
          }
        }
      }
    },
    "Apple tar emot appen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple is taking the app in"
          }
        }
      }
    },
    "Apple tog inte emot appen än. Något saknas eller behöver rättas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple did not take the app yet. Something is missing or needs to be put right."
          }
        }
      }
    },
    "Apple vill veta vem de kan kontakta om appen. Fyll i det här en gång, så används det för alla dina appar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple wants to know who to contact about the app. Fill this in once, and it is used for all your apps."
          }
        }
      }
    },
    "Apple vill veta vilka uppgifter appen samlar in. Det går bara att svara på hos Apple, under App Privacy på appens sida där.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple wants to know what the app collects. That can only be answered at Apple, under App Privacy on the app's page there."
          }
        }
      }
    },
    "Apple visade inte vilket team kontot har. Det står under Membership details, tio tecken långt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple did not show which team the account has. It is shown under Membership details, ten characters long."
          }
