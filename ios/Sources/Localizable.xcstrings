          "stringUnit": {
            "state": "translated",
            "value": "Get your app out"
          }
        }
      }
    },
    "För att installera appen behövs ett Apple-utvecklarkonto att ladda upp den till.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To install the app, an Apple developer account to upload it to is needed."
          }
        }
      }
