            "value": "First name"
          }
        }
      }
    },
    "Förslaget bygger på appens kod. Läs igenom det: du står för det som publiceras.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The suggestion is based on the app's code. Read it through: you answer for what is published."
          }
        }
      }
    },
    "Förslaget hittade det här i appens kod. Sätt i så fall åldersgränsen själv i App Store Connect:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The suggestion found this in the app's code. If so, set the age rating yourself in App Store Connect:"
          }
        }
      }
    },
    "Förslaget hittade inget sådant i appens kod.": {
      "localizations": {
        "en": {
