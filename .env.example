# --- Server ---------------------------------------------------------------
# Anthropic API key used by the app-building agent.
ANTHROPIC_API_KEY=
# Shared secret between the server and the Mac build workers. Use a long random string.
WORKER_TOKEN=
# If set, people need this code to create an account (recommended while testing).
INVITE_CODE=
PORT=8787
# Model and effort for the agent.
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high
# Max chat messages per user per day (each message can cost a fair amount of tokens).
DAILY_MESSAGE_LIMIT=50
# Reverse-DNS prefix for generated apps' bundle identifiers.
BUNDLE_ID_PREFIX=app.appsmedjan
# Set to 1 when running behind a reverse proxy (nginx, Caddy, a load balancer).
TRUST_PROXY=
# Only needed if the web page is served from a different origin than the server (comma separated).
ALLOWED_ORIGINS=
# Emails that may use YOUR Apple developer account besides the operators (OPERATOR_EMAILS), who always
# may: for TestFlight, the App Store and apps signed for their own phone (comma separated, or * for
# everyone). Empty keeps it to the operators. People who connect their own Apple account are not listed.
TESTFLIGHT_USERS=
# Lets people connect their own Apple developer account: their App Store Connect keys are stored
# encrypted with this. Use a long random string (for example: openssl rand -hex 32) and keep it;
# if it changes, the stored keys can no longer be read and people have to connect again.
SECRETS_KEY=

# The iPhone app sends a moving finger where iOS reckons it is heading, which takes a little off the wait
# for what follows it in the simulator. Set to 0 to have it sent where it is.
# PREDICT_FINGER=0

# --- Mac build worker (set these on the Mac) ------------------------------
# SERVER_URL=wss://your-domain.example
# WORKER_TOKEN=<same as on the server>
# MAX_SIMULATORS=2
# Touches reach the simulator through one open connection, so a list follows the finger. Set to 0 to go
# back to one idb command per touch, which is slower but has been in use longer.
# LIVE_TOUCH=0
# The screen is sent as video (H.264, up to sixty pictures a second) to viewers that can show it. Set to 0
# to send JPEG frames to everyone, as before.
# LIVE_VIDEO=0
# A viewer whose connection keeps falling behind is sent a lighter video, half the size each way. Set to 0
# to send everyone the full one.
# LIVE_LIGHT=0
# SIM_DEVICE=iPhone 16
# Days before simulators and build folders nobody has used are deleted from the Mac (0 keeps everything).
# PRUNE_AFTER_DAYS=14
# Uploads to people's own Apple accounts: set to 1 to let this Mac handle their keys. A key is written
# to a private temporary folder for the length of one upload. Apps in the simulator run as the same
# user and could read it, so for a public service use a separate Mac with PREVIEWS=0 for this.
# PUBLISH_FOR_USERS=1
# Signing-only worker: uploads to TestFlight but runs no simulators.
# PREVIEWS=0
# Uploads to your own account (all four, or leave them out). The key file comes from App Store Connect
# and is downloaded once; keep it outside the repository.
# APPLE_TEAM_ID=ABCDE12345
# ASC_KEY_ID=
# ASC_ISSUER_ID=
# ASC_KEY_PATH=~/secrets/AuthKey_XXXXXXXXXX.p8

# Emails of the people who run the service (comma separated). They are shown which apps are waiting
# to be created in App Store Connect for uploads to your own developer account.
# OPERATOR_EMAILS=you@example.com

# Who Apple may contact about apps tested from your developer account, for people who have not
# given contact details of their own. Without it they are asked for theirs before a test link is made.
# BETA_CONTACT=First Last, +46 70 123 45 67, you@example.com

# Lets people who use your developer account be invited to its team as internal testers of their
# own app (role Developer, that app only). They then get builds within minutes instead of waiting
# for Apple's beta review. A team has room for 100 internal testers.
# INTERNAL_TESTERS=1

# Lets people who use your developer account add their own phone and have apps signed for it, so an
# app installs straight from a link: no TestFlight, no review, no app to create in App Store Connect.
# Every phone takes one of the account's 100 places for a year, and Apple means those for people who
# test with you. People with their own connected account can always do this.
# DIRECT_INSTALL=1
# MAX_PHONES_PER_USER=2

# Plans. With PAYWALL=1, what a person may do depends on the plan they have been given: how many
# apps and messages, whether apps can be put on a phone, and whether they get the App Store guide
# (the plans themselves are in shared/protocol.ts). There is no payment yet: a person asks for a
# plan in the app, and you give it to them on the start page. Without PAYWALL everything is open.
# PAYWALL=1
# The plan of a person who has not been given one: free, create or publish.
# DEFAULT_PLAN=free
# What the smallest plan holds, when it is to hold something else than usual. FREE_APPS=0 makes
# it a paywall: anyone can make an account and look around, and nothing is built before they have
# a larger plan.
# FREE_APPS=0
# FREE_MESSAGES=0
# Codes that let a person past the paywall without paying, separated by commas. A code on its own
# gives the largest plan; "code=create" gives that plan. At least four characters each.
# UNLOCK_CODES=
# What the plans cost, shown beside them. Leave out to show no prices.
# PLAN_PRICES=create=99 kr i månaden; publish=249 kr i månaden

# The address phones reach the service at, when it cannot be worked out from the request.
# PUBLIC_URL=https://example.com
